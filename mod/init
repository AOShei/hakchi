#!/bin/sh

cd /bin
busybox --list | busybox xargs -n1 busybox ln -ns "busybox"
cd /

# devtmpfs does not get automounted for initramfs
#mkdir -p /dev /proc /sys
mount -t devtmpfs devtmpfs /dev

console="/dev/console"
[ -f "/.debug" ] && console="/dev/tty0"
exec 0<"$console"
exec 1>"$console"
exec 2>"$console"

if [ -f "/.debug" ]; then
  printf '\e[3J\e[1;32;40m'
  decodepng "/hakchi/rootfs/etc/hakchi.png" > "/dev/fb0" &
  usleep 100000
  for i in . . .; do echo; done
  echo 'DEBUG BUILD!'
fi

mount -t proc proc /proc
mount -t sysfs sys /sys
mkdir -p /dev/pts /dev/shm
mount -o defaults,gid=5,mode=620 -t devpts devpts /dev/pts
mount -o mode=077 -t tmpfs tmpfs /dev/shm

time -f 'nand init: %E' insmod "/lib/modules-ramfs/kernel/drivers/block/nand/nand.ko"

keyfile="/key-file"
for i in $(cat "/proc/cmdline"); do
  if [ "$i" = "ro" ]; then
    READONLY="y"
  elif [ "${i#root=}" != "$i" ]; then
    ROOTFS="${i#root=}"
  elif [ "$i" = "decrypt" ]; then
    DECRYPT="y"
  elif [ "${i#hakchi-key-file=base64:}" != "$i" ]; then
    echo "${i#hakchi-key-file=base64:}" | base64 -d >"$keyfile"
  fi
done

isSquashfs(){
  [ -b "$1" ] || return 1
  [ "$(hexdump -e '1/4 "%u"' -s 0 -n 4 "$1")" = "1936814952" ] && return 0
  return 1
}

isSquashfs "${ROOTFS}" && DECRYPT="n"

if ! [ -f "$keyfile" ] && [ "$DECRYPT" = "y" ]; then
  kfb64="$(sunxi-flash cmdline | sed -ne 's/.*hakchi-key-file=base64:\([^ ]*\).*/\1/p')" && ! [ -z "$kfb64" ] && echo "$kfb64" | base64 -d >"$keyfile"
  unset kfb64
  [ -f "$keyfile" ] || sunxi-flash ramdisk 68 | cpio -iu "$(basename "$keyfile")" 2>/dev/null
  [ -f "$keyfile" ] || sunxi-flash ramdisk | cpio -iu "$(basename "$keyfile")" 2>/dev/null
  if ! [ -f "$keyfile" ]; then
    echo nandc
  fi
fi

MOUNT_OPTS="noatime"
[ "${READONLY}" = "y" ] && MOUNT_OPTS="ro,${MOUNT_OPTS}"

if [ "${DECRYPT}" = "y" ]; then
  [ "${READONLY}" = "y" ] && READONLY="--readonly"
  [ -f "$keyfile" ] && cryptsetup open "${ROOTFS}" root-crypt "${READONLY}" --type plain --cipher aes-xts-plain --key-file "$keyfile"
  if isSquashfs "/dev/mapper/root-crypt"; then
    ROOTFS="/dev/mapper/root-crypt"
  else
    ROOTFS="/dev/none"
    [ -f "$keyfile" ] && cryptsetup close root-crypt
  fi
fi

mountpoint="/newroot"
mkdir -p "$mountpoint"
isSquashfs "${ROOTFS}" && mount -o "${MOUNT_OPTS}" "${ROOTFS}" "$mountpoint"

# SEGA
if ! mountpoint -q "$mountpoint"; then
  mount -o ro,noatime "/dev/nandd" "$mountpoint"
  [ -f "$mountpoint/etc/init.d/moon-game" ] || umount "$mountpoint"
fi

[ -f "/hakchi/init" ] && time -f 'preinit: %E' sh "/hakchi/init"

exec 0</dev/console
exec 1>/dev/console
exec 2>/dev/console
mount --move /dev "$mountpoint/dev"
mount --move /proc "$mountpoint/proc"
mount --move /sys "$mountpoint/sys"
exec switch_root "$mountpoint" /sbin/init
