#!/bin/sh
source /etc/preinit
script_init

if [ "$cfg_wood" = "y" ]; then
  exec 1>>/var/log/networking.log 2>&1
  [ "$#" -gt 1 ] && echo "$(basename "$0") ${1+"$@"}"
fi

interfaces="/etc/network/interfaces"

interfaceUp(){
  ifaceDown "$1" || return 0
  [ -f "$interfaces.d/$1" ] || return 0
  local i
  for i in . . . . . . . . .; do
    ifup "$1" -i "$interfaces.d/$1" && return 0
  done
}

interfaceDown(){
  [ -f "$interfaces.d/$1" ] && ifdown "$1" -i "$interfaces.d/$1" 2>/dev/null
  ip link set "$1" down 2>/dev/null
}

start(){
  if ! haveUsbBus; then
    echo "usbMode: $(usbMode)"
    exit 1
  fi

  ifup -a
  for i in $(ls "$interfaces.d"); do
    interfaceUp "$i" &
  done
}

stop(){
  for i in $(ls -r "$interfaces.d"); do
    interfaceDown "$i" &
  done
  wait
  ifdown -a
  ip link set lo down
  killall udhcpc 2>/dev/null
}

restart(){
  stop
  start
}

case "$1" in
  start)
    start
  ;;
  stop)
    stop
  ;;
  restart)
    restart
  ;;
  udev)
    ifaceUp "lo" || exit 0
    haveUsbBus || exit 1
    self="$(readlink -f "$0")"
    echo "\"$self\" udev-detached-$ACTION $INTERFACE" >> "/var/exec.flag"
  ;;
  udev-detached|udev-detached-)
    haveUsbBus || exit 1
    restart
  ;;
  udev-detached-add)
    haveUsbBus || exit 1
    interfaceUp "$2"
  ;;
  udev-detached-remove)
    haveUsbBus || exit 1
    interfaceDown "$2"
  ;;
  *)
    echo "Usage: $(basename "$0") {start|stop|status|restart}"
    exit 1
  ;;
esac
