#!/bin/sh

if lsmod | grep -qF "overlayfs"; then
  if ! mount | grep -qE 'rootfs on .* type overlayfs'; then
    mount_move l media
    mount_move l var
    mount -t overlayfs rootfs -o "rw,noatime,lowerdir=$mountpoint,upperdir=${rootfs##$mountpoint}" "$mountpoint"
    mount_move r var
    mount_move r media
  fi
fi
